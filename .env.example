# Sites: leave these unset; authentication is supplied by Sites dispatch.
# Standalone: configure in standalone/wrangler.json and wrangler secret bulk.
# AUTH_MODE=standalone
# OWNER_ID=personal-owner
# COACH_KEY_HASH=<SHA256 of random coach key>
# LOGIN_KEY_HASH=<SHA256 of separate random browser key>
# SESSION_SECRET=<random 32-byte secret>
