                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/routine": {
      "get": {
        "operationId": "getRoutine",
        "description": "Read the latest saved routine and its revision.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "saveRoutine",
        "description": "Save a complete routine for FUTURE workouts. Preserve fields the user did not ask to change. expectedRevision prevents stale overwrites.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requestId",
                  "expectedRevision",
                  "reason",
                  "routine"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "routine": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "notes",
                      "constraints",
                      "workouts"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "notes": {
                        "type": "string",
                        "maxLength": 2000
                      },
                      "constraints": {
                        "type": "array",
                        "maxItems": 15,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "workouts": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 7,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "name",
                            "notes",
                            "timeLimitMinutes",
                            "exercises"
                          ],
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 180
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 80
                            },
                            "notes": {
                              "type": "string",
                              "maxLength": 2000
                            },
                            "timeLimitMinutes": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 5,
                              "maximum": 180
                            },
                            "exercises": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 20,
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "variantId",
                                  "minReps",
                                  "maxReps",
                                  "sets",
                                  "targetRir"
                                ],
                                "properties": {
                                  "variantId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 180
                                  },
                                  "minReps": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 50
                                  },
                                  "maxReps": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 50
                                  },
                                  "sets": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 10
                                  },
                                  "targetRir": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 3
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/apply": {
      "post": {
        "operationId": "adjustActiveWorkout",
        "description": "Adjust exercise lineup and prescriptions for TODAY only. Logged sets, pain pauses, notes, deadlines and existing session rules remain. Read context for expectedConfiguration.",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requestId",
                  "sessionId",
                  "expectedConfiguration",
                  "reason",
                  "workout"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  },
                  "sessionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  },
                  "expectedConfiguration": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "workout": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "exercises"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "exercises": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 20,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "variantId",
                            "minReps",
                            "maxReps",
                            "sets",
                            "targetRir"
                          ],
                          "properties": {
                            "variantId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 180
                            },
                            "minReps": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 50
                            },
                            "maxReps": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 50
                            },
                            "sets": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 10
                            },
                            "targetRir": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 3
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/history": {
      "get": {
        "operationId": "getTrainingHistory",
        "description": "Read paginated sets, session notes, or routine revisions. Restore a prior routine by saving its contents as a new revision.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "sets",
                "sessions",
                "revisions"
              ],
              "default": "sets"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Revision cursor from nextBefore; only used for revisions."
          },
          {
            "name": "variantId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sessionId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
