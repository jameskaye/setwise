{
  "openapi": "3.1.0",
  "info": {
    "title": "Setwise Coach",
    "version": "1.0.0",
    "description": "Read saved strength workouts and update current or future routines for the account owner."
  },
  "servers": [
    {
      "url": "https://setwise.example.invalid"
    }
  ],
  "security": [
    {
      "coachKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "coachKey": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/api/coach/context": {
      "get": {
        "operationId": "getTrainingContext",
        "description": "Read current routine, exercise catalog, active session, recent sets and notes. History is partial; fetch more pages when needed.",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Stored data or acknowledged change. A 409 requires a fresh read before a new change.",
